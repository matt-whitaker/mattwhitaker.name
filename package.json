{
  "name": "mattwhitaker.name",
  "version": "0.0.1",
  "description": "Home of my personal websites",
  "main": "index.js",
  "scripts": {
    "test": "npm run test -ws --if-present",
    "build": "npm run build -ws --if-present",
    "pdf": "npm run pdf -ws --if-present",
    "combined:build": "npm run build && rsync -avr --ignore-existing packages/www/dist . && rsync -avr --ignore-existing packages/resume/dist .",
    "combined:serve": "http-server ./dist -p 8080 -c-1 -o -r"
  },
  "author": "Matt Whitaker",
  "license": "ISC",
  "workspaces": [
    "packages/resume",
    "packages/tools",
    "packages/www"
  ],
  "devDependencies": {
    "http-server": "^14.1.1"
  }
}
