{
  "name": "mattwhitaker.name",
  "version": "0.0.1",
  "description": "Home of my personal websites",
  "main": "index.js",
  "scripts": {
    "test": "npm run test -ws --if-present",
    "build": "npm run build -ws --if-present",
    "pack:clear": "rm -rf ./dist",
    "pack:resume": "rsync -avr --ignore-existing packages/resume/dist .",
    "pack:www": "rsync -avr --ignore-existing packages/www/dist .",
    "serve": "http-server ./dist -p 8080 -c-1 -r"
  },
  "author": "Matt Whitaker",
  "license": "ISC",
  "workspaces": [
    "packages/resume",
    "packages/tools",
    "packages/www"
  ],
  "devDependencies": {
    "http-server": "^14.1.1"
  }
}
