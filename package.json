{
  "name": "mattwhitaker.name",
  "version": "0.0.1",
  "description": "Home of my personal websites",
  "main": "index.js",
  "scripts": {
    "clear": "npm run clear -ws --if-present",
    "test": "npm run test -ws --if-present",
    "build": "npm run build -ws --if-present",
    "build:dev": "npm run build:dev -ws --if-present",
    "pack:clear": "rm -rf ./dist",
    "pack:blog": "rsync -avr --ignore-existing packages/blog/dist .",
    "pack:resume": "rsync -avr --ignore-existing packages/resume/dist .",
    "pack:www": "rsync -avr --ignore-existing packages/www/dist .",
    "pack": "npm run pack:clear && npm run pack:blog && npm run pack:resume && npm run pack:www",
    "pack:dev": "npm run pack:clear && npm run pack:blog && npm run pack:resume && npm run pack:www",
    "serve": "http-server ./dist -p 8080 -c-1 -r",
    "start": "npm run build:dev && npm run pack:dev && npm run serve"
  },
  "author": "Matt Whitaker",
  "license": "ISC",
  "workspaces": [
    "packages/resume",
    "packages/core",
    "packages/www",
    "packages/blog",
    "packages/common"
  ],
  "devDependencies": {
    "http-server": "^14.1.1"
  }
}
