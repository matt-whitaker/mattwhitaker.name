---
import '../style.css';
import site from '../../site.config.js';
import { careerSkills } from '../data/career-skills.js';

// Subpages (project detail pages) override these; the defaults keep
// the homepage exactly as before.
const {
  title = site.title,
  description = site.description,
  image = site.headshot,
} = Astro.props;
const canonical = site.url + Astro.url.pathname;
const isHome = Astro.url.pathname === '/';

const knowsAbout = Object.values(careerSkills)
  .flat()
  .map((skill) => skill.name);
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Matt Whitaker',
  url: site.url,
  image: site.url + site.headshot,
  jobTitle: site.jobtitle,
  description: site.description,
  sameAs: [site.linkedin, site.github, site.emwhit],
  knowsAbout,
};
---

<html lang="en" class="scroll-smooth motion-reduce:scroll-auto">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* Must stay is:inline — a bundled/module script is always deferred
        and would run after the hero paints, causing a visible flash
        (see .js-motion in style.css). */}
    <script is:inline>
      if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
        document.documentElement.classList.add('js-motion');
      }
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Matt Whitaker" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Matt Whitaker" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={site.url + image} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={site.url + image} />

    {/* Homepage-only: images below the fold that would otherwise
        visibly pop in as their section scrolls into view. */}
    {isHome && (
      <>
        <link rel="preload" href="/images/headshot.jpg" as="image" />
        <link rel="preload" href="/images/b-roll.jpg" as="image" />
        <link rel="preload" href="/images/doggy1.jpg" as="image" />
        <link rel="preload" href="/images/doggy2.jpg" as="image" />
      </>
    )}
    <link rel="icon" type="image/png" href="/favicon/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="shortcut icon" href="/favicon/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Matt Whitaker" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={site.fonts.urbanist} rel="stylesheet" />
    <script is:inline src={site.fontawesome} crossorigin="anonymous"></script>

    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
  </head>
  <body class="bg-paper font-body text-ink">
    <slot />
    <script>
      import '../main.js';
    </script>
  </body>
</html>
