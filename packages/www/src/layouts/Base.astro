---
import '../style.css';
import site from '../../site.config.js';
import { careerSkills } from '../data/career-skills.js';

const title = 'Matt Whitaker — Senior Frontend Engineer';

const knowsAbout = Object.values(careerSkills)
  .flat()
  .map((skill) => skill.name);
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Matt Whitaker',
  url: site.url,
  image: site.url + '/images/headshot.jpg',
  jobTitle: 'Senior Frontend Engineer',
  description: site.description,
  sameAs: [site.linkedin, site.github, site.emwhit],
  knowsAbout,
};
---

<html lang="en" class="scroll-smooth motion-reduce:scroll-auto">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/*
      Must stay is:inline (blocking, unbundled) so it runs and paints
      before the hero markup below does — a bundled/module script never
      can, since modules are always deferred. Without this, the hero
      briefly shows at full opacity, then GSAP's initial state snaps it
      to opacity:0 once main.js finally runs, then fades it back in: a
      visible flash. The .js-motion CSS rule (src/style.css) hides
      [data-hero-item] up front instead, so there's nothing to flash.
    */}
    <script is:inline>
      if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
        document.documentElement.classList.add('js-motion');
      }
    </script>
    <title>{title}</title>
    <meta name="description" content={site.description} />
    <meta name="author" content="Matt Whitaker" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={site.url + '/'} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Matt Whitaker" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={site.url + '/'} />
    <meta property="og:image" content={site.url + '/images/headshot.jpg'} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={site.description} />
    <meta name="twitter:image" content={site.url + '/images/headshot.jpg'} />

    <link rel="preload" href="/images/headshot.jpg" as="image" />
    <link rel="icon" type="image/png" href="/favicon/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="shortcut icon" href="/favicon/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Matt Whitaker" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={site.fonts.urbanist} rel="stylesheet" />
    <script is:inline src={site.fontawesome} crossorigin="anonymous"></script>

    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
  </head>
  <body class="bg-paper font-body text-ink">
    <slot />
    {/*
      Bundled as a deferred module — same timing as the old
      end-of-body type="module" script tag. All motion init lives in
      main.js; nothing animation-related belongs in components.
    */}
    <script>
      import '../main.js';
    </script>
  </body>
</html>
