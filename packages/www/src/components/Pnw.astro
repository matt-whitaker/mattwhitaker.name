---
// PNW section between Career and Emwhit — a full-viewport block in two
// stacked parts:
//   1. an atmospheric image "peek" window (the panning b-roll), fixed
//      height at the top;
//   2. PNW lifestyle content filling the rest of the viewport below it.
// The section is min-h-screen and a flex column, so the content pane is
// flex-1 and naturally takes "the rest of the page height" under the
// peek — peek + content == one screen.
//
// The <img> is oversized (h-[160%], pulled up with top-[-30%]) to give
// the parallax headroom; motion/pnw.js pans it as the peek scrolls
// through. `top` is a position offset, not a transform, so GSAP's
// yPercent owns the transform cleanly. object-position sits high on the
// frame so the visible crop reads from the upper part of the photo.
// Decorative image → aria-hidden + empty alt, lazy-loaded.
---

<section id="life" data-pnw class="flex min-h-screen flex-col bg-paper">
  {/* Image peek / window */}
  <div data-broll aria-hidden="true" class="relative h-[42vh] shrink-0 overflow-hidden md:h-[45vh]">
    <img
      data-broll-img
      src="/images/b-roll.jpg"
      alt=""
      decoding="async"
      class="absolute left-0 top-[-30%] h-[160%] w-full object-cover object-[50%_3%] md:object-[50%_10%]"
    />
  </div>

  {/* PNW content — fills the rest of the viewport below the peek. */}
  <div class="flex flex-1 items-center px-6 py-16">
    <div
      data-pnw-content
      class="mx-auto grid w-full max-w-5xl grid-cols-1 items-center gap-12 md:grid-cols-2"
    >
      <div>
        <p class="text-sm font-semibold uppercase tracking-widest text-accent">Pacific Northwest</p>
        <h2 class="mt-2 font-display text-4xl font-bold text-ink">born and raised</h2>
        <p class="mt-4 max-w-xl text-ink/80">
          I grew up on the coast of Pacific Northwest and went to school at the
          University of Washington. These days I'm on the eastside, in the shadow of the
          Cascades.
        </p>
      </div>

      {/* Two askew portrait photo frames — matted white with a thin black
          keyline. The inner boxes are placeholders until real photos drop
          in (swap bg-ink/10 for an <img>). */}
      <figure class="mx-auto">
        <div class="relative mx-auto h-64 w-[18rem]">
          <div class="absolute left-0 top-0 w-40 rotate-[-6deg] bg-white p-3 shadow-xl">
            <img class="aspect-[3/4] w-full border border-ink/80" src="/images/doggy1.jpg" />
          </div>
          <div class="absolute right-0 top-8 w-40 rotate-[5deg] bg-white p-3 shadow-xl">
            <img class="aspect-[3/4] w-full border border-ink/80" src="/images/doggy2.jpg" />
          </div>
        </div>
        <figcaption class="mt-4 text-center text-sm italic text-ink/60">Corgis!</figcaption>
      </figure>
    </div>
  </div>
</section>
