---
import site from '../../site.config.js';

const year = new Date().getFullYear();
---

<section id="contact" data-social class="border-t border-ink/10 px-6 py-24">
  <div class="mx-auto max-w-2xl text-center">
    <p class="text-sm font-semibold uppercase tracking-widest text-accent">Contact</p>
    <h2 class="mt-2 font-display text-4xl font-bold text-ink">Let's build something.</h2>
    <p class="mt-4 text-ink/80">
      The fastest way to reach me is below. I read everything myself.
    </p>
    <a
      href={'mailto:' + site.email}
      data-copy-email
      data-email={site.email}
      class="mt-8 inline-block rounded-full bg-accent px-6 py-3 text-sm font-semibold text-paper transition-colors hover:bg-accent-soft"
    >
      <span data-copy-email-label aria-live="polite">{site.email}</span>
    </a>
  </div>

  <ul class="mx-auto mt-8 flex max-w-2xl flex-wrap items-center justify-center gap-x-8 gap-y-3 text-4xl">
    <li>
      <a
        target="_blank"
        href={site.linkedin}
        class="text-accent-soft transition-colors hover:text-accent"
      >
        <i class="fa-brands fa-linkedin"></i>
      </a>
    </li>
    <li>
      <a
        target="_blank"
        href={site.github}
        class="text-accent-soft transition-colors hover:text-accent"
      >
        <i class="fa-brands fa-square-github"></i>
      </a>
    </li>
  </ul>
</section>

<footer class="border-t border-ink/10 px-6 py-8">
  <div class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-2 text-sm text-ink/50 sm:flex-row">
    <p>&copy; {year} Matt Whitaker.</p>
    <p>Built with Astro, Tailwind CSS, and GSAP.</p>
  </div>
</footer>
