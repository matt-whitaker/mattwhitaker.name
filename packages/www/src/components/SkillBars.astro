---
import { maxSkillYears, strengthLabels, strengthOpacity } from '../data/career-skills.js';

const { skills, accent = false } = Astro.props;
---

<ul class="skill-bars">
  {skills.map((skill) => (
    <li>
      <div class="skill-bar__meta">
        <span class="skill-bar__name">{skill.name}</span>
        {/* Years are deliberately not printed — they only drive the bar's
            width (below). Strength stays as text because the fill opacity
            alone can't convey a tier accessibly. */}
        <span class="skill-bar__detail">{strengthLabels[skill.strength]}</span>
      </div>
      <div class:list={['skill-bar__track', accent && 'skill-bar__track--accent']} aria-hidden="true">
        <div
          class:list={['skill-bar__fill', accent && 'skill-bar__fill--accent']}
          style={`width: ${Math.round((skill.years / maxSkillYears) * 100)}%; opacity: ${strengthOpacity[skill.strength]}%`}
        >
        </div>
      </div>
    </li>
  ))}
</ul>
