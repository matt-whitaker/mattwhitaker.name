---
import { Icon } from 'astro-icon/components';
import { stackGroups } from '../data/stack.js';

// Radial placement is plain trigonometry resolved at build time, output
// as percentages of the square container onto CSS custom properties that
// the desktop branch of `.stack-node` consumes.
const RADIUS = 45; // % from center to each node's center
const SPOKE_END = 23; // % where a connector stops, short of its node

const angleFor = (i) => (i / stackGroups.length) * Math.PI * 2 - Math.PI / 2; // -90° puts node 0 at 12 o'clock

const nodes = stackGroups.map((group, i) => {
  const angle = angleFor(i);
  const cos = Math.cos(angle);
  const sin = Math.sin(angle);
  return {
    ...group,
    x: (50 + RADIUS * cos).toFixed(2),
    y: (50 + RADIUS * sin).toFixed(2),
    spokeX: (50 + SPOKE_END * cos).toFixed(2),
    spokeY: (50 + SPOKE_END * sin).toFixed(2),
  };
});
---

{/* Centering lives on the section (like Emwhit), not an inner
    min-h-[inherit] wrapper — that would inherit 100vh into a child of a
    py-24 section, stacking the padding on top of a full viewport. */}
<section
  id="stack"
  data-stack
  class="flex min-h-screen flex-col justify-center bg-accent px-6 py-24 text-paper"
>
  {/* flex-col-reverse on mobile puts the intro copy above the wheel (it
      reads as the lede); the desktop grid lays them out in DOM order. */}
  <div
    {/* minmax(0, …) rather than a bare 65fr/35fr — an fr track's implicit
        min-content minimum can otherwise refuse to shrink and push the
        grid wider than its container. */}
    class="mx-auto flex w-full max-w-6xl flex-col-reverse gap-14 min-[880px]:grid min-[880px]:grid-cols-[minmax(0,65fr)_minmax(0,35fr)] min-[880px]:items-center min-[880px]:gap-10"
  >
    {/* min(100%, 46vw, 62vh): 46vw is what makes the wheel track window
        *width* — without it the height cap always wins (a 65% column on
        a wide screen is ~870px, taller than any viewport). 62vh caps it
        vertically. Width binds ~880-1400px; above that it's height-bound. */}
    <div
      data-stack-wheel
      class="@container relative w-full min-[880px]:mx-auto min-[880px]:aspect-square min-[880px]:w-[min(100%,46vw,62vh)]"
    >
      {/* 0 0 100 100 viewBox maps 1:1 onto the square container's
          percentage space, matching the nodes'. Decorative. */}
      <svg
        viewBox="0 0 100 100"
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 hidden h-full w-full min-[880px]:block"
      >
        {nodes.map((node) => (
          <line
            data-stack-spoke
            x1="50"
            y1="50"
            x2={node.spokeX}
            y2={node.spokeY}
            stroke="currentColor"
            stroke-width="0.25"
            class="text-paper/25"
          />
        ))}
      </svg>

      {/* Wrapper owns the desktop centering transform; GSAP only fades
          the hub, never writes transform (see motion/stack.js). */}
      <div
        data-stack-hub
        class="hidden justify-center min-[880px]:absolute min-[880px]:top-1/2 min-[880px]:left-1/2 min-[880px]:flex min-[880px]:-translate-x-1/2 min-[880px]:-translate-y-1/2"
      >
        <span class="stack-hub text-paper" aria-hidden="true">
          <Icon name="headshot-icon" class="h-[92%] w-auto" />
        </span>
      </div>

      <ul class="stack-list">
        {nodes.map((node) => (
          <li class="stack-node" style={`--x: ${node.x}%; --y: ${node.y}%`} data-stack-node>
            <ul class="stack-node__icons">
              {node.icons.map((icon) => (
                <li title={icon.name}>
                  {/* title on the <li> gives a uniform hover tooltip for
                      both icon.icon (astro-icon) and the FA fallback. */}
                  {icon.icon
                    ? <Icon name={icon.icon} aria-hidden="true" />
                    : <i class={icon.className} aria-hidden="true"></i>}
                  <span class="sr-only">{icon.name}</span>
                </li>
              ))}
            </ul>
            <p class="stack-node__label">{node.label}</p>
            <p class="stack-node__blurb">{node.blurb}</p>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold uppercase tracking-widest text-paper/70">Stack</p>
      <h2 class="mt-2 font-display text-4xl font-bold">a rough picture of me.</h2>
      <p class="mt-4 text-paper/80">
        A general look at the kinds of technology I have worked with, showcasing stronger
        experience. I'm always interested in learning new things and trying new technology.
      </p>
    </div>
  </div>
</section>
