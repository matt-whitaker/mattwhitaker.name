---
import { Icon } from 'astro-icon/components';
---

<section
  id="intro"
  data-hero
  class="flex min-h-screen items-center border-b border-ink/10 px-6 pt-24 pb-16"
>
  <div
    class="mx-auto flex max-w-5xl flex-col items-center gap-10 text-center md:flex-row md:items-center md:text-left"
  >
    <img
      data-hero-item
      src="/images/headshot.jpg"
      alt="Headshot of Matt Whitaker"
      width="200"
      height="200"
      class="h-40 w-40 shrink-0 rounded-full object-cover ring-4 ring-accent/10"
    />

    <div class="flex flex-col items-center md:items-start">
      <h1 data-hero-item class="font-display text-5xl font-light tracking-tight text-ink">
        Matt Whitaker
      </h1>

      <p data-hero-item class="mt-4 max-w-xl text-lg text-ink/80">
        Full-stack career &bull; Front-end focus &bull; AI powered
      </p>

      <p data-hero-item class="mt-3 max-w-xl text-base text-ink/60">
        Over a decade of building cloud based web applications, up and down the stack, specializing in
        <span class="whitespace-nowrap"><i class="fa-brands fa-react align-[-0.125em]" aria-hidden="true"></i> React</span> +
        <span class="whitespace-nowrap"><Icon name="simple-icons:typescript" aria-hidden="true" class="inline-block align-[-0.125em]" /> TypeScript</span> +
        <span class="whitespace-nowrap"><i class="fa-brands fa-node-js align-[-0.125em]" aria-hidden="true"></i> Node</span>.
        <!-- Enhanced with AI <Icon name="simple-icons:claudecode" title="Claude Code" class="inline-block align-[-0.15em]" /> -->
      </p>

      <div data-hero-item class="mt-8 flex flex-wrap items-center justify-center gap-4 md:justify-start">
        <a
          href="#career"
          class="rounded-full bg-accent px-6 py-3 text-sm font-semibold text-paper transition-colors hover:bg-accent-soft"
        >
          My story
        </a>
        <a
          href="#contact"
          class="rounded-full border border-accent/30 px-6 py-3 text-sm font-semibold text-accent transition-colors hover:border-accent hover:bg-accent/5"
        >
          Get in touch
        </a>
      </div>
    </div>
  </div>
</section>
