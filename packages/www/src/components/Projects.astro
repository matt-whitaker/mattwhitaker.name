---
import { getCollection } from 'astro:content';
import ContentCard from './ContentCard.astro';

const projects = await getCollection('projects');
---

<section id="projects" data-projects class="px-6 py-24">
  <div class="mx-auto max-w-5xl">
    <p class="text-sm font-semibold uppercase tracking-widest text-accent">Projects</p>
    <h2 class="mt-2 font-display text-4xl font-bold text-ink">Some stuff I've built</h2>
    <p class="mt-4 max-w-2xl text-ink/80">
      Learnings and musings about personal projects.
    </p>
    <div data-project-grid class="mt-10 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {projects.map((project) => (
        <ContentCard item={project.data} attr="data-project-card" href={'/projects/' + project.id} />
      ))}
    </div>
  </div>
</section>
