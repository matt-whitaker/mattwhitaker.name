---
import site from '../../site.config.js';

// Three stacked sine waves (slow/broad, medium, fast/low-amplitude) read
// as spectrum-like "clumps" rather than uniform noise. Weights sum to 1
// so the envelope stays within roughly ±1 before scaling.
const barCount = 28;
const barHeights = Array.from({ length: barCount }, (_, i) => {
  const t = i / (barCount - 1);
  const envelope =
    Math.sin(t * Math.PI * 2.2 + 0.4) * 0.55 +
    Math.sin(t * Math.PI * 6 + 1.5) * 0.3 +
    Math.sin(i * 2.7) * 0.15;
  return Math.round(50 + envelope * 46);
});
---

<section
  id="music"
  data-emwhit
  class="relative flex min-h-screen flex-col justify-center overflow-hidden bg-ink px-6 py-24 text-paper min-[880px]:h-screen"
>
  <div
    data-emwhit-bars
    class="mx-auto mb-16 flex h-28 w-full max-w-5xl items-end justify-between gap-1"
    aria-hidden="true"
  >
    {barHeights.map((h) => (
      <span data-emwhit-bar class="emwhit-bar" style={`height: ${h}%`}></span>
    ))}
  </div>

  <div class="mx-auto flex w-full max-w-5xl flex-col gap-10 md:flex-row md:items-center">
    <div class="overflow-hidden rounded-2xl border border-paper/10 shadow-xl md:w-80 md:shrink-0">
      <img
        src="/images/emwhit-screenshot.png"
        alt="The Emwhit Project"
        width="694"
        height="692"
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover"
      />
    </div>

    <div>
      <p class="text-sm font-semibold uppercase tracking-widest text-accent-soft">The Emwhit Project</p>
      <h2 class="mt-2 font-display text-4xl font-bold">an independent music project.</h2>
      <p class="mt-4 max-w-xl text-paper/80">
        Solo and self-taught, The Emwhit Project is my music side passion, giving me a way to share my voice.
        It serves as my creative, expressive outlet, contrasting with with the more logical and problem-oriented world of my career.
      </p>

      <div class="mt-8 flex flex-wrap gap-4">
        <a
          target="_blank"
          rel="noopener"
          href={site.emwhit}
          class="rounded-full border border-paper/20 px-5 py-2.5 text-sm font-semibold transition-colors hover:border-accent-soft hover:text-accent-soft"
        >
          Website
        </a>
      </div>
    </div>
  </div>
</section>
