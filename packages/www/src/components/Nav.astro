---
import site from '../../site.config.js';
---

<header
  data-nav
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent bg-transparent px-6 transition-colors duration-300 motion-reduce:transition-none"
>
  <nav
    class="mx-auto flex max-w-5xl items-center justify-between py-4"
    aria-label="Primary"
  >
    <a href="/" data-nav-invert class="hidden font-display text-sm font-normal tracking-wide text-ink md:inline-block">
      Matt Whitaker
    </a>

    <ul data-nav-invert class="hidden items-center gap-6 text-sm text-ink md:flex">
      {site.navLinks.map((link) => (
        <li><a href={link.href} class="transition-colors hover:text-accent">{link.label}</a></li>
      ))}
    </ul>

    <details data-nav-menu class="ml-auto md:hidden">
      <summary
        data-nav-invert
        aria-label="Menu"
        class="flex h-9 w-9 list-none items-center justify-center rounded-full text-ink transition-colors hover:text-accent"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </summary>
      <ul class="absolute inset-x-0 top-full flex flex-col gap-1 border-b border-ink/10 bg-paper px-6 py-4 text-sm shadow-lg">
        {site.navLinks.map((link) => (
          <li><a href={link.href} class="block py-2 transition-colors hover:text-accent">{link.label}</a></li>
        ))}
      </ul>
    </details>
  </nav>
</header>
