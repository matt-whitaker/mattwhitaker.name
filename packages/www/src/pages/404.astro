---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import SocialFooter from '../components/SocialFooter.astro';
---

<Layout
  title="Page not found — Matt Whitaker"
  description="That page doesn't exist. Head back to mattwhitaker.name."
>
  <Nav />

  <main class="flex min-h-screen items-center px-6 pt-32 pb-24">
    <div class="mx-auto max-w-3xl text-center">
      <p class="font-display text-8xl font-light tracking-tight text-accent">404</p>

      <h1 class="mt-4 font-display text-5xl font-light tracking-tight text-ink">
        This page wandered off
      </h1>

      <p class="mx-auto mt-4 max-w-xl text-lg text-ink/80">
        The link is broken, or whatever lived here has since moved on. Everything worth
        finding is one scroll away.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/"
          class="rounded-full bg-accent px-6 py-3 text-sm font-semibold text-paper transition-colors hover:bg-accent-soft"
        >
          Back home
        </a>
        <a
          href="/#contact"
          class="rounded-full border border-accent/30 px-6 py-3 text-sm font-semibold text-accent transition-colors hover:border-accent hover:bg-accent/5"
        >
          Get in touch
        </a>
      </div>
    </div>
  </main>

  <SocialFooter />
</Layout>
