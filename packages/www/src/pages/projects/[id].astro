---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import SocialFooter from '../../components/SocialFooter.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, blurb, tags, href, hrefLabel, thumbnail } = project.data;
const hrefText = hrefLabel ? hrefLabel : `Visit ${new URL(href).host}`;
---

<Layout title={title + ' — Matt Whitaker'} description={blurb} image={thumbnail}>
  <Nav />

  <main class="px-6 pt-32 pb-24">
    <article class="mx-auto max-w-3xl">
      <a href="/#projects" class="text-sm font-semibold text-accent transition-colors hover:text-accent-soft">
        &larr; All projects
      </a>

      <h1 class="mt-4 font-display text-5xl font-light tracking-tight text-ink">{title}</h1>
      <p class="mt-4 text-lg text-ink/80">{blurb}</p>

      <ul class="mt-4 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <li class="chip">{tag}</li>
        ))}
      </ul>

      <div class="mt-8 overflow-hidden rounded-2xl border border-ink/10 shadow-sm">
        <img src={thumbnail} alt="" width="1200" height="800" class="w-full object-cover" />
      </div>

      <div class="project-body mt-10">
        <Content />
      </div>

      <a
        href={href}
        target="_blank"
        class="mt-10 inline-block rounded-full bg-accent px-6 py-3 text-sm font-semibold text-paper transition-colors hover:bg-accent-soft"
      >
        {hrefText} &rarr;
      </a>
    </article>
  </main>

  <SocialFooter />
</Layout>
