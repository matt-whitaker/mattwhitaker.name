{
  "name": "@mattwhitaker.name/www",
  "version": "0.0.1",
  "description": "Asset build for main website",
  "scripts": {
    "clear": "rm -rf ./dist",
    "template": "bin/template.js",
    "template:dev": "bin/template.js --dev",
    "template:watch": "nodemon --exec \"npm run template:dev\" -e txt,ejs,json --ignore dist/",
    "style": "npx tailwindcss -m -i ./style/tailwind.css -o ./dist/style/main.min.css",
    "style:dev": "npx tailwindcss -i ./style/tailwind.css -o ./dist/style/main.css",
    "style:watch": "npm run style:dev -- --watch",
    "static": "bin/static.js --source static --output dist && bin/static.js --source ../assets --output dist",
    "serve": "http-server ./dist -p 8080 -c-1 -r",
    "build": "npm run clear && npm run style && npm run template && npm run static",
    "build:dev": "npm run clear && npm run style:dev && npm run template:dev && npm run static",
    "start": "npm run clear && npm run static && concurrently \"npm run template:watch\" \"npm run style:watch\" \"npm run serve\""
  },
  "author": "Matt Whitaker (https://mattwhitaker.name)",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "args": "^5.0.3",
    "concurrently": "^8.2.2",
    "ejs": "^3.1.9",
    "http-server": "^14.1.1",
    "markdown-it": "^14.1.1",
    "minify": "^11.4.0",
    "nodemon": "^3.0.3",
    "tailwindcss": "^3.4.4"
  }
}
