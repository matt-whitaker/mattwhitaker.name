{
  "name": "@mattwhitaker.name/www",
  "version": "0.0.1",
  "description": "Asset build for main website",
  "scripts": {
    "clear": "rm -rf ./dist",
    "template": "bin/template.js --stylesheet style/main.css",
    "template:watch": "nodemon --exec \"npm run template\" -e ejs,json --ignore dist/",
    "style": "lessc style/index.less dist/style/main.css",
    "style:watch": "nodemon --exec \"npm run style\" -e css,less --ignore dist/",
    "static": "cp -r ./../common/static/* dist && cp -r ./static/* ./dist",
    "serve": "http-server ./dist -p 8080 -c-1 -r",
    "build": "npm run clear && npm run style && npm run template && npm run static",
    "start": "npm run clear && npm run static && concurrently \"npm run template:watch\" \"npm run style:watch\" \"npm run serve\"",
    "lint": "stylelint style/**/*.less",
    "lint:fix": "npm run lint -- --fix"
  },
  "author": "Matt Whitaker (https://mattwhitaker.name)",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "args": "^5.0.3",
    "concurrently": "^8.2.2",
    "ejs": "^3.1.9",
    "http-server": "^14.1.1",
    "less": "4.2.0",
    "markdown-it": "^13.0.2",
    "nodemon": "^3.0.3",
    "stylelint": "15.11.0",
    "stylelint-config-standard": "34.0.0",
    "stylelint-config-standard-less": "2.0.0"
  }
}
