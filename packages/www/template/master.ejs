<!DOCTYPE html>
<html>
    <head>
        <title><%= site.title %> - <%= page.title %></title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="<%= rendered.stylesheet %>" rel="stylesheet" />
        <link href="<%- site.google.fonts %>" rel="stylesheet" />
        <script src="<%- site.fa.script %>" crossorigin="anonymous"></script>
    </head>
    <body class="mw-body <%= page.class %>">
        <% if (page.banner) { %>
        <%- await include("/template/component/banner.ejs", { img: page.banner, desc: page.bannerDesc }) %>
        <% } %>
        <div class="mw-scrollbody">
            <div class="mw-ribbon"></div>
            <%- rendered.content %>
        </div>
    </body>
</html>