<%# title Matt Whitaker - Frontend / Fullstack Developer %>
<%# author Matt Whitaker %>
<%# description Matt Whitaker's personal and professional profile. Frontend-leaning fullstack engineer with over a decade of experience. %>
<%# keywords Matt Whitaker, Lead Frontend Engineer, Senior Fullstack Engineer, Senior Frontend Engineer, HTML, CSS, React, Redux, RxJS, Node.js, Express.js, Jest, Less, Enzyme, Java, Spring, AWS, Docker, Kubernetes %>
<%# banner /image/b-roll.jpg %>
<%# bannerDesc Mt. Si %>
<article class="self-end box-border w-full p-md sm:p-xl max-sm:h-[calc(100dvh-(100dvh-400px))] mt-[calc(100dvh-400px)] text-[.9em] sm:text-lg bg-white sm:rounded-b-lg">
    <img class="float-left mr-md sm:mr-2xl rounded-[4px] shadow-[.1ex_.1ex_.35ex] shadow-black md:w-[300px] md:h-[300px] sm:w-[200px] sm:h-[200px] w-[90px] h-[90px] block animate-opacity_in" src="/image/headshot.jpg" title="Picture of myself" alt="Picture of myself" />
    <header>
        <h1 class="mt-lg sm:mt-md sm:mb-4 leading-7 sm:text-4xl text-3xl font-light whitespace-nowrap"><%= lookup("me") %></h1>
        <ul class="text-right whitespace-nowrap leading-8 flex flex-wrap sm:flex-nowrap">
            <li class=""><a class="hover:underline [&>svg]:mr-4 text-gold" href="https://www.linkedin.com/in/whitakermatt">
                    <i class="fa-brands fa-linkedin"></i><%= lookup("linkedin") %></a>
            </li>
            <li class="ml-md sm:ml-md"><a class="hover:underline [&>svg]:mr-4 text-gold" href="https://github.com/matt-whitaker">
                    <i class="fa-brands fa-github"></i><%= lookup("github") %></a>
            </li>

            <% if (feature("blog")) { %>
                <li class="ml-md sm:ml-md"><a class="hover:underline [&>svg]:mr-4 text-gold" href="/blog"><i class="fa-solid fa-user-pen"></i><%= lookup("blog") %></a></li>
            <% } %>

            <% if (feature("opentowork")) { %>
                <li class="ml-md sm:ml-auto mr-0 flex items-center sm:w-auto">
                    <span class="text-sm mr-sm animate-pulse opacity-90 text-green hidden sm:inline-block lowercase"><%= lookup("open_to_work") %></span>
                    <a class="hover:underline [&>svg]:mr-4 text-gold" href="/resume" target="_blank"><i class="fa-solid fa-file-lines"></i><%= lookup("Resume") %></a>
                </li>
            <% } %>
        </ul>
    </header>
    <main class="flex-inline flex-col animate-opacity_in sm:[&>*]:leading-[22px] [&>*]:leading-[20px] max-sm:clear-both max-sm:mt-lg">
        <p class=""><%- lookup("summary_1") %></p>
        <p class="sm:mt-md mt-sm"><%- lookup("summary_2") %></p>
    </main>
</article>
