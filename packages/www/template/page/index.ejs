<%# title Matt Whitaker %>
<%# banner /image/snoval-bw-manual.png %>
<%# bannerDesc Snoqualmie Falls depiction (ChatGPT/DALL-E) %>
<main class="mw-overview">
    <img class="mw-headshot" src="/image/tmp_me.jpeg" title="Picture of myself" alt="Picture of myself" />
    <div class="mw-info">
        <header>
            <h1>Matt Whitaker</h1>
            <h2>principle front-end engineer | full-stack veteran</h2>
        </header>
        <section>
            <!-- hidden inputs -->
            <input id="mw-slot-1" type="radio" name="tab" checked>
            <input id="mw-slot-2" type="radio" name="tab">
            <input id="mw-slot-3" type="radio" name="tab">
            <input id="mw-slot-4" type="radio" name="tab">

            <!-- Labels for controlling inputs, and serve as the tab navigation -->
            <div class="mw-tabs">
                <label for="mw-slot-1" rel="tab" tabindex="0">About</label>
                <% if (site.features.overview.career) { %>
                <span>-</span>
                <label for="mw-slot-2" rel="tab" tabindex="0">Career</label>
                <% } %>
                <span>-</span>
                <label for="mw-slot-3" rel="tab" tabindex="0">Technology</label>
                <span>-</span>
                <label for="mw-slot-4" rel="tab" tabindex="0">Leadership</label>
            </div>

            <!-- Content, controlled by the inputs' checked state, downstream for CSS selection -->
            <section class="mw-slot mw-slot-1">
                <div class="mw-flair">
                    <p class="mw-hello">Hi, I'm <span>Matt</span>!</p>
                    &nbsp;
                    <p>I am a seasoned and versatile full stack software engineer with well over a decade of experience in the industry. This experience spans from adopting and maintaining existing systems, to several greenfield solutions over my career.</p>
                    <p>I have had the privilege of working on a variety of different web-focused archetypes ranging from administrative interfaces, to distributed backend systems, and to customer success solutions. <span class="mw-tag">learn more</span></p>
                </div>
            </section>
            <section class="mw-slot mw-slot-2">
                <div class="mw-flair mw-standin">
                    <i class="fa-solid fa-lock fa-6x"></i>
                </div>
            </section>
            <section class="mw-slot mw-slot-3">
                <div class="mw-flair">
                    <p>Leveraging a variety of technoloiges throughout my career, I have designed and delivered a number of service and system archetypes.</p>
                    &nbsp;
                    <%- await include("/template/component/tag-array.ejs", { tags: ["Front-end component libraries", "Standalone web applications", "Micro-frontends", "Front-facing API services", "CRUD services", "Orchestrative services", "Distributed back-end systems"] }) %>
                </div>
                <%- await include("/template/component/icon-marquee.ejs", { className: "mw-slot-3", items: ["fa-square-js", "fa-react", "fa-less", "fa-node", "fa-python", "fa-java", "fa-aws", "fa-docker"] }) %>
            </section>
            <section class="mw-slot mw-slot-4">
                <div class="mw-flair">
                    <p>I have spent a significant portion of my career taking on leadership roles</p>
                    <p>
                        <%- await include("/template/component/tag.ejs", { tag: "Agile - SCRUM" }) %>
                        Extensive experience driving a variety of SCRUM ceremonies and process, and am able to lead teams through them.
                    </p>
                    <p>
                        <%- await include("/template/component/tag.ejs", { tag: "Lifecycle - Delivery" }) %>
                        Numerous opportunities to take projects from their earliest conceptions, through team activation and delegation, to release.
                    </p>
                    <p>
                        <%- await include("/template/component/tag.ejs", { tag: "Mentorship - Growth - Success" }) %>
                        I have successfully mentored engineers in various stages of their career as well as help build teams through hiring.
                    </p>
                </div>
            </section>
        </section>
    </div>
</main>