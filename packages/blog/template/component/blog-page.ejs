<%
const markdownClasses = [
    "[&>*]:my-sm",
    "[&>h1]:mt-lg mb-md [&>h1]:text-xl [&>h1]:font-semibold",
    "[&>h2]:mt-md mb-sm [&>h2]:text-md [&>h2]:font-normal [&>h2]:uppercase",
    "[&>h3]:mt-sm mb-xs [&>h3]:text-md [&>h3]:font-semibold",
    "[&>p]:leading-5",
    "[&>ul>li]:leading-5 [&>ul>li]:mt-sm [&>ul>li]:list-[square] [&>ul>li]:ml-md",
    "[&>hr]:my-lg",
    "[&>pre]:overflow-x-auto [&>pre]:text-sm"
].join(" ");
%>
<main class="sm:mx-auto w-full sm:max-w-xl px-md sm:px-0 text-left relative">
    <div class="opacity-0 animate-opacity_in" style="animation-delay: 100ms">
        <a href="/blog" class="hover:before:font-light hover:before:text-lg hover:before:top-[-2px] hover:before:left-[-18px] hover:before:absolute hover:before:content-['<'] hover:underline absolute top-[calc(60px-36px)] text-gold">back</a>
        <h1 class="sm:text-3xl text-2xl mt-[60px] sm:leading-7 leading-7"><%= page.title %></h1>
        <div class="text-sm text-gold leading-8">
            <span><%= page.publish %></span>
            <span class="uppercase float-right"><%= page.tag %></span>
        </div>
    </div>
    <div class="<%= markdownClasses %> mt-[60px] opacity-0 animate-opacity_in" style="animation-delay: 170ms"><%- md(markdown) %></div>
</main>