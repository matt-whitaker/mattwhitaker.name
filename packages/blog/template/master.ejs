<!DOCTYPE html>
<html lang="en">
<head>
    <title><%= page.title %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="<%- page.description %>">
    <meta name="keywords" content="<%= page.keywords %>">
    <meta name="author" content="<%= page.author %>">

    <meta property="og:title" content="<%= page.title %>">
    <meta property="og:description" content="<%- page.description %>">
    <meta property="og:url" content="https://mattwhitaker.name/blog">
    <meta property="og:type" content="website">

    <link rel="canonical" href="https://mattwhitaker.name/blog">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <% stylesheets.forEach((stylesheet) => {%>
    <link href="<%= cachebust(minified(stylesheet)) %>" rel="stylesheet" />
    <% }) %>
    <link href="<%- site.google.fonts %>" rel="stylesheet" />
</head>
<body class="text-black w-screen h-[calc(100vh - 50px)] m-[0_auto] box-border bg-goldstone bg-fixed print:bg-transparent <%= page.class %>" style="background-image: url('/image/cubes.png')">
    <div class="mt-[18px] md:my-[48px] pb-[36px] md:rounded-lg relative max-w-[1092px] flex flex-col my-0 mx-auto box-border bg-white">
        <%- await include("/template/component/header.ejs") %>
        <%- await include("/template/component/menu.ejs") %>
        <%- await include(`/template/page/${page.relativePath}/${page.filename}`) %>
    </div>
</body>
</html>