{
  "name": "@mattwhitaker/blog",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "clear": "rm -rf ./dist",
    "template": "bin/template.js",
    "template:dev": "bin/template.js --dev",
    "template:watch": "nodemon --exec \"npm run template:dev\" -e txt,ejs,json,md --ignore dist/",
    "style": "npx tailwindcss -m -i ./style/tailwind.css -o ./dist/style/blog.min.css",
    "style:dev": "npx tailwindcss -i ./style/tailwind.css -o ./dist/style/blog.css",
    "style:watch": "npm run style:dev -- --watch",
    "static": "bin/static.js --source ../common/static --output dist",
    "serve": "http-server ./dist -p 8080 -c-1 -r",
    "build": "npm run clear && npm run style && npm run template && npm run static",
    "build:dev": "npm run clear && npm run style:dev && npm run template:dev && npm run static",
    "start": "npm run clear && npm run static && concurrently \"npm run template:watch\" \"npm run style:watch\" \"npm run serve\""
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "autoprefixer": "^10.4.20",
    "markdown-it": "^14.1.0",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.8"
  }
}
