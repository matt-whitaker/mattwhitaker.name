<section id="projects" data-projects class="px-6 py-24">
  <div class="mx-auto max-w-5xl">
    <p class="text-sm font-semibold uppercase tracking-widest text-accent">Projects</p>
    <h2 class="mt-2 font-display text-4xl font-bold text-ink">Stuff I've built on my own</h2>

    <!--
      Data-driven grid — adding a project is an edit to src/data/projects.js,
      never a change to this markup. Card component lives in
      content-card.ejs (shared with Case Studies).
    -->
    <div data-project-grid class="mt-10 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      <% projects.forEach(function (project) { %>
        <%- include('./content-card.ejs', { item: project, attr: 'data-project-card' }) %>
      <% }); %>
    </div>
  </div>
</section>
