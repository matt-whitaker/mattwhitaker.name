<% const navLinks = [
  { href: '#intro', label: 'Intro' },
  { href: '#career', label: 'Career' },
  { href: '#music', label: 'Music' },
  { href: '#projects', label: 'Projects' },
  { href: '#contact', label: 'Contact' },
]; %>
<header
  data-nav
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent bg-transparent transition-colors duration-300 motion-reduce:transition-none"
>
  <nav
    class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4"
    aria-label="Primary"
  >
    <!--
      Logo only shows at md+ — on mobile it's redundant with the name
      already in the hero heading, and just gets in the way of a fixed
      bar that's supposed to be unobtrusive. Fine for it to scroll away.
    -->
    <a href="#intro" class="hidden font-display text-sm font-semibold tracking-wide text-ink md:inline-block">
      Matt Whitaker<span class="text-accent">.</span>
    </a>

    <ul class="hidden items-center gap-6 text-sm md:flex">
      <% navLinks.forEach(function (link) { %>
        <li><a href="<%= link.href %>" class="transition-colors hover:text-accent"><%= link.label %></a></li>
      <% }); %>
    </ul>

    <!--
      Mobile menu — a native <details>/<summary> disclosure rather than
      a JS-only toggle, so it opens/closes correctly even with JS off.
      src/motion/nav.js only adds one enhancement: closing it again
      after a link is tapped.
    -->
    <details data-nav-menu class="ml-auto md:hidden">
      <summary
        aria-label="Menu"
        class="flex h-9 w-9 list-none items-center justify-center rounded-full text-ink transition-colors hover:text-accent"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </summary>
      <ul class="absolute inset-x-0 top-full flex flex-col gap-1 border-b border-ink/10 bg-paper px-6 py-4 text-sm shadow-lg">
        <% navLinks.forEach(function (link) { %>
          <li><a href="<%= link.href %>" class="block py-2 transition-colors hover:text-accent"><%= link.label %></a></li>
        <% }); %>
      </ul>
    </details>
  </nav>
</header>
