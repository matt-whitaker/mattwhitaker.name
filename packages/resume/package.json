{
  "name": "@mattwhitaker.name/resume",
  "version": "0.0.1",
  "description": "Asset build for resume",
  "scripts": {
    "clear": "rm -rf ./dist",
    "template": "bin/template.js",
    "template:dev": "bin/template.js --dev",
    "template:offline": "bin/template.js --dev --pages template/offline --lang offline.txt",
    "template:watch": "nodemon --exec \"npm run template:dev\" -e txt,ejs,json --ignore dist/",
    "tailwind": "npx tailwindcss -m -i ./style/tailwind.css -o ./dist/style/resume.min.css",
    "tailwind:dev": "npx tailwindcss -i ./style/tailwind.css -o ./dist/style/resume.css",
    "tailwind:watch": "npm run tailwind:dev -- --watch",
    "style": "npm run tailwind",
    "style:dev": "npm run tailwind:dev",
    "style:watch": "npm run tailwind:watch",
    "generate:resume": "mkdir -p dist/pdf && bin/pdf.js --page resume.html --name MattWhitakerResume",
    "generate:cover": "mkdir -p dist/pdf && bin/pdf.js --page cover.html --name MattWhitakerCoverLetter",
    "generate:all": "npm run generate:resume",
    "static": "bin/static.js --source ../common/static --output dist",
    "build": "npm run clear && npm run style && npm run template && npm run static",
    "build:dev": "npm run clear && npm run static && npm run style:dev && npm run template:dev",
    "build:offline": "npm run clear && npm run static && npm run style:dev && npm run template:offline",
    "serve": "http-server ./dist -p 8080 -c-1 -r",
    "start": "npm run clear && npm run static && concurrently \"npm run template:watch\" \"npm run style:watch\" \"npm run serve\""
  },
  "author": "Matt Whitaker (https://mattwhitaker.name)",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "args": "^5.0.3",
    "concurrently": "^8.2.2",
    "ejs": "^3.1.9",
    "http-server": "^14.1.1",
    "markdown-it": "^13.0.2",
    "nodemon": "^3.0.3",
    "puppeteer": "^22.10.0",
    "stylelint": "15.11.0",
    "stylelint-config-standard": "34.0.0",
    "tailwindcss": "^3.4.6"
  }
}
