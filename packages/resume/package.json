{
  "name": "@mattwhitaker.name/resume",
  "version": "0.0.1",
  "description": "Asset build for resume",
  "scripts": {
    "clear": "rm -rf ./dist",
    "template": "bin/template.js --stylesheet style/resume.css",
    "template:watch": "nodemon --exec \"npm run template -- --dev --all\" -e txt,ejs,json --ignore dist/",
    "style": "lessc style/index.less dist/style/resume.css",
    "style:watch": "nodemon --exec \"npm run style\" -e css,less --ignore dist/",
    "generate:resume": "mkdir -p dist/pdf && bin/pdf.js --page resume.html",
    "generate:resume-ats": "mkdir -p dist/pdf && bin/pdf.js --page resume-ats.html",
    "generate:cover": "mkdir -p dist/pdf && bin/pdf.js --page cover.html",
    "static": "bin/static.js --source ../common/static --output dist",
    "build": "npm run clear && npm run style && npm run template && npm run static",
    "build:dev": "npm run clear && npm run static && npm run style && npm run template -- --dev --all",
    "serve": "http-server ./dist -p 8080 -c-1 -r",
    "start": "npm run clear && npm run static && concurrently \"npm run template:watch\" \"npm run style:watch\" \"npm run serve\"",
    "lint": "stylelint style/**/*.less",
    "lint:fix": "npm run lint -- --fix"
  },
  "author": "Matt Whitaker (https://mattwhitaker.name)",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "args": "^5.0.3",
    "concurrently": "^8.2.2",
    "ejs": "^3.1.9",
    "http-server": "^14.1.1",
    "less": "4.2.0",
    "markdown-it": "^13.0.2",
    "nodemon": "^3.0.3",
    "puppeteer": "^22.10.0",
    "stylelint": "15.11.0",
    "stylelint-config-standard": "34.0.0",
    "stylelint-config-standard-less": "2.0.0"
  }
}
