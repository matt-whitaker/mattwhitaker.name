{
  "name": "@mattwhitaker.name/resume",
  "version": "0.0.1",
  "description": "Asset build for resume",
  "scripts": {
    "build": "npm run clear && npm run less && npm run template && npm run image",
    "clear": "rm -rf ./dist",
    "template": "bin/template.js --stylesheet resume.css",
    "template:watch": "nodemon bin/template.js -e ejs,json --ignore dist/ --stylesheet resume.css",
    "image": "cp -r ../common/image ./dist",
    "lint": "stylelint style/**/*.less",
    "lint:fix": "npm run lint -- --fix",
    "less": "lessc style/index.less dist/resume.css",
    "less:watch": "nodemon --exec \"lessc style/index.less dist/resume.css\" -e css,less --ignore dist/",
    "serve": "http-server ./dist -p 8080 -c-1 -r",
    "start": "concurrently \"npm run template:watch\" \"npm run less:watch\" \"npm run serve\"",
    "pdf": "cp -r pdf ./dist",
    "pdf:resume": "bin/pdf.js --page resume.html && cp dist/resume.pdf ./pdf",
    "pdf:cover": "bin/pdf.js --page cover.html && cp dist/cover.pdf ./pdf",
    "test:integration": ""
  },
  "author": "Matt Whitaker (https://mattwhitaker.name)",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "args": "^5.0.3",
    "concurrently": "^8.2.2",
    "ejs": "^3.1.9",
    "http-server": "^14.1.1",
    "less": "4.2.0",
    "markdown-it": "^13.0.2",
    "nodemon": "^3.0.3",
    "puppeteer": "^22.10.0",
    "stylelint": "15.11.0",
    "stylelint-config-standard": "34.0.0",
    "stylelint-config-standard-less": "2.0.0"
  }
}
