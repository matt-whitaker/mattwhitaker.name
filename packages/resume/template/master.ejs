<!DOCTYPE html>
<html lang="en">
    <head>
        <title><%= page.title %></title>
        <meta name="robots" content="noindex" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <% stylesheets.forEach((stylesheet) => {%>
        <link href="<%= cachebust(minified(stylesheet)) %>" rel="stylesheet" />
        <% }) %>
        <link href="<%- site.google.fonts %>" rel="stylesheet" />
    </head>
    <body class="bg-fixed bg-bgshade text-normal overflow-x-hidden print:overflow-x-auto <%= page.class %>" style="background-image: url('/image/cubes.png');">
        <%- await include(`/${page.path}/${page.filename}`) %>
    </body>
</html>