<article class="min-h-[60px] pr-large">
    <p class="pb-xxsmall mb-xxsmall">
        <b class="text-lg"><%- lookup(`${prefix}_jobtitle`) %></b><br/>
        <span><%= lookup(`${prefix}_name`) %></span>
        <span><%= lookup(`${prefix}_years`) %></span>
        <span class="italic"><%= lookup(`${prefix}_address`) %></span>
    </p>
    <ul>
        <li class="mb-xxsmall text-[.78em] leading-[1.3em]"><%- lookup(`${prefix}_summary`) %></li>
        <% for (let i = 1; i <= 4; i++) { %>
            <% if (lookup(`${prefix}_${i}`, "")) { %>
                <li class="mb-[3px]] ml-medium text-[.78em] leading-[1.3em] list-square"><%- lookup(`${prefix}_${i}`) %></li>
            <% } %>
        <% } %>
        <li class="mt-xxsmall mb-xxsmall text-sm leading-[1.3em]"><%- template(lookup("skills"), { skills: lookup(`${prefix}_skills`) }) %></li>
    </ul>
</article>