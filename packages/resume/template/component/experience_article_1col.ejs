<article class="min-h-[60px] pr-large pt-xsmall">
    <div>
        <b class="text-lg font-semibold"><%- lookup(`${prefix}_jobtitle`) %></b>
        <br />
        <span><%= lookup(`${prefix}_name`) %></span>
        <span class="ml-xsmall"><%= lookup(`${prefix}_years`) %></span>
        <address class="inline not-italic ml-xsmall"><%= lookup(`${prefix}_address`) %></address>
    </div>
    <ul class="pt-xxsmall">
        <li class="mb-xxsmall text-[.78em] leading-common"><%- lookup(`${prefix}_summary`) %></li>
        <% for (let i = 1; i <= 4; i++) { %>
            <% if (lookup(`${prefix}_${i}`, "")) { %>
                <li class="mb-[3px]] ml-medium text-[.78em] leading-common list-square"><%- lookup(`${prefix}_${i}`) %></li>
            <% } %>
        <% } %>
        <li class="mt-xxsmall mb-xxsmall text-sm leading-common"><%- template(lookup("skills"), { skills: lookup(`${prefix}_skills`) }) %></li>
    </ul>
</article>