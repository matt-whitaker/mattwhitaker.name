<header class="flex flex-col float-right">
    <div class="flex">
        <img class="m-large w-[137px] h-[137px]" src="/image/headshot.jpg" alt="<%= lookup("headshot") %>" />
        <div class="ml-large flex-grow-[1] flex flex-col items-stretch">
            <%- await include("/template/component/title.ejs") %>
            <%- await include("/template/component/subtitle.ejs") %>
            <address class="mt-[3px] not-italic"><%= lookup("address") %></address>
        </div>
    </div>
    <div class="border-box w-letter-width p-large bg-black bg-opacity-30">
        <p class="pl-sidebar text-[.9em] leading-[1.15em]"><%= lookup("summary") %></p>
    </div>
</header>