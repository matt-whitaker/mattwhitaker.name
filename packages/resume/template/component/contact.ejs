<aside class="pt-large <%= column === "sidebar" ? "pr-xsmall" : "pl-large" %>">
    <%- await include("/template/component/heading.ejs", { text: lookup("h_contact"), column  }) %>
    <ul class="pl-large text-right">
        <li class="text-sm leading-[1.3em]">
            <span title="<%= hide("", lookup("contact_phone_note")) %>">
                <b><%= lookup("contact_phone") %></b> <br />
                <%= hide("+1 (253) 886 0195", "+a (xxx) yyy zzzz") %>
            </span>
        </li>
        <li class="mt-xxsmall text-sm leading-[1.3em]">
            <span>
                <b><%= lookup("contact_email") %></b> <br />
                hire@mattwhitaker.name
            </span>
        </li>
        <li class="mt-xxsmall text-sm leading-[1.3em]">
            <span>
                <b><%= lookup("contact_website") %></b> <br />
                mattwhitaker.name
            </span>
        </li>
    </ul>
</aside>

