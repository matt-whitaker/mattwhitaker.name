<aside class="pt-large <%= column === "sidebar" ? "pr-xsmall" : "pl-large" %> text-right flex-grow">
<% if (!alt) { %>
    <%- await include("/template/component/heading.ejs", { text: lookup("h_skills"), column  }) %>
    <div class="pl-large flex flex-col">
        <%- await include("/template/component/skill_figure.ejs", { titleKey: "h_language", dataKey: "d_language", separator: false }) %>
        <%- await include("/template/component/skill_figure.ejs", { titleKey: "h_framework", dataKey: "d_framework", separator: true }) %>
        <%- await include("/template/component/skill_figure.ejs", { titleKey: "h_infrastructure", dataKey: "d_infrastructure", separator: true }) %>
    </div>
<% } else { %>
    <%- await include("/template/component/heading.ejs", { text: lookup("h_skills"), column }) %>
    <div class="flex flex-grow">
        <%- await include("/template/component/skill_figure.ejs", { titleKey: "h_language", dataKey: "d_language", separator: false }) %>
        <%- await include("/template/component/skill_figure.ejs", { titleKey: "h_framework", dataKey: "d_framework", separator: false }) %>
        <%- await include("/template/component/skill_figure.ejs", { titleKey: "h_infrastructure", dataKey: "d_infrastructure", separator: false }) %>
    </div>
<% } %>
</aside>