<figure>
    <figcaption><%= lookup(titleKey) %></figcaption>
    <ul>
    <% JSON.parse(lookup(dataKey)).forEach(([years, string]) => { %>
        <li class="mw-years-<%= years %>"><span><%- template(lookup("years"), { years }) %></span><span><%= string %></span></li>
    <% }) %>
    </ul>
</figure>