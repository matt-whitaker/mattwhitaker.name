                    </header>
                    <main class="mw-resume-job-desc">
                        <ul>
                            <li><%= lookup("appl_summary") %></li>
                            <li><%= lookup("appl_1") %></li>
                            <li><%= lookup("appl_2") %></li>
                            <li><%- lookup("appl_skills") %></li>
                        </ul>
                    </main>
                </article>
                <article>
                    <header class="mw-resume-job-title">
                        <p>
                            <span><%= lookup("slal_jobtitle") %></span><br/>
                            <span><%= lookup("slal_years") %></span>
                        </p>
                        <p>
                            <span><%= lookup("slal_name") %></span><br/>
                        <address><%= lookup("slal_address") %></address>
                        </p>
                    </header>
                    <main class="mw-resume-job-desc">
                        <p></p>
                        <ul>
                            <li><%= lookup("slal_summary") %></li>
                            <li><%= lookup("slal_1") %></li>
                            <li><%= lookup("slal_2") %></li>
                            <li><%= lookup("slal_3") %></li>
                            <li><%- lookup("slal_skills") %></li>
                        </ul>
                    </main>
                </article>
                <article>
                    <header class="mw-resume-job-title">
                        <p>
                            <span><%- lookup("uw_jobtitle") %></span><br/>
                            <em><%= lookup("uw_focus") %></em><br/>
                            <span><%= lookup("uw_years") %></span>
                        </p>
                        <p>
                            <span><%= lookup("uw_name") %></span><br/>
                        <address><%= lookup("uw_address") %></address>
                        </p>
                    </header>
                    <main class="mw-resume-job-desc">
                        <ul>
                            <li><%= lookup("uw_summary") %></li>
                            <li><%= lookup("uw_1") %></li>
                            <li><%= lookup("uw_2") %></li>
                            <li><%= lookup("uw_3") %></li>
                            <li><%- lookup("uw_skills") %></li>
                        </ul>
                    </main>
                </article>
            </div>
            <div class="mw-resume-ref">
                <h2><span><%= lookup("h_references") %></span></h2>
                <article>
                    <%= lookup("references") %>
                </article>
            </div>
        </div>
        <div class="mw-resume-sidebar pg2">
            <header class="mw-resume-alt-header">
                <h1>Matt<br/>Whitaker</h1>
                <h2><%= lookup("short_jobtitle") %></h2>
            </header>
            <section class="mw-resume-edu">
                <h2>
                    <span><%= lookup("h_education") %></span>
                </h2>
                <p>
                    <span><%= lookup("edu_degree") %></span> <br/>
                    <span><%= lookup("edu_focus") %></span>
                </p>
                <p>
                    <b><%= lookup("edu_school") %></b>
                    <address><%= lookup("edu_address") %></address>
                </p>
            </section>
            <section class="mw-resume-social">
                <h2><span><%= lookup("h_social") %></span></h2>
                <p><b>Github</b><br/> <!--https://github.com/-->matt-whitaker</p>
                <p><b>LinkedIn</b><br/> <!--https://www.linkedin.com/in/-->whitakermatt</p>
            </section>
        </div>
    </div>
</main>