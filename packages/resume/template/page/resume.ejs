<%# title Matt Whitaker - Resume - Lead Front-end Engineer %>
<main class="mw-resume">
    <div class="mw-resume-page pg1">
        <div class="mw-resume-content pg1">
            <header class="mw-resume-header">
                <h1>Matt<br/>Whitaker</h1>
                <h2><%= lookup("jobtitle") %></h2>
                <address><%= lookup("address") %></address>
            </header>
            <section class="mw-resume-ribbon">
                <p></p>
                <p><%= lookup("summary") %></p>
            </section>
            <div class="mw-resume-exp">
                <h2><span><%= lookup("h_experience") %></span></h2>
                <article>
                    <header class="mw-resume-job-title">
                        <p>
                            <span><%= lookup("smar_jobtitle") %></span><br/>
                            <em><%= lookup("smar_focus") %></em><br/>
                            <span><%= lookup("smar_years") %></span>
                        </p>
                        <p>
                            <span><%= lookup("smar_name") %></span><br/>
                            <address><%= lookup("smar_address") %></address>
                        </p>
                    </header>
                    <main class="mw-resume-job-desc">
                        <ul>
                            <li><%= lookup("smar_summary") %></li>
                            <li><%= lookup("smar_1") %></li>
                            <li><%= lookup("smar_2") %></li>
                            <li><%= lookup("smar_3") %></li>
                            <li><%= lookup("smar_4") %></li>
                            <li><%- lookup("smar_skills") %></li>
                        </ul>
                    </main>
                </article>
                <article>
                    <header class="mw-resume-job-title">
                        <p>
                            <span><%= lookup("sap_jobtitle") %></span><br/>
                            <em><%= lookup("sap_focus") %></em><br/>
                            <span><%= lookup("sap_years") %></span>
                        </p>
                        <p>
                            <span><%= lookup("sap_name") %></span><br/>
                            <address><%= lookup("sap_address") %></address>
                        </p>
                    </header>
                    <main class="mw-resume-job-desc">
                        <ul>
                            <li><%= lookup("sap_summary") %></li>
                            <li><%= lookup("sap_1") %></li>
                            <li><%= lookup("sap_2") %></li>
                            <li><%= lookup("sap_3") %></li>
                            <li><%- lookup("sap_skills") %></li>
                        </ul>
                    </main>
                </article>
            </div>
        </div>
        <div class="mw-resume-sidebar pg1">
            <section class="mw-resume-contact">
                <img class="mw-resume-headshot" src="/image/headshot.jpg" />
                <%- await include("/template/component/contact.ejs") %>
            </section>
            <section class="mw-resume-skills">
                <h2><span><%= lookup("h_skills") %></span></h2>
                <figure>
                    <figcaption><%= lookup("h_language") %></figcaption>
                    <ul>
                        <li><span>&#x25A0; &#x25A0; &#x25A0; &#x25A0; &#x25A0;</span>HTML / CSS</li>
                        <li><span>&#x25A0; &#x25A0; &#x25A0; &#x25A0; &#x25A0;</span>JavaScript</li>
                        <li><span>&#x25A0; &#x25A0; &#x25A0; &#x25A0; &#x25A0;</span>TypeScript</li>
                        <li><span>&#x25A0; &#x25A0; &#x25A0; &#x25A0;</span>Node.js</li>
                        <li><span>&#x25A0; &#x25A0; &#x25A0;</span>Java</li>
                    </ul>
                </figure>
                <figure>
                    <span>- - -</span>
                    <figcaption><%= lookup("h_framework") %></figcaption>
                    <ul>
                        <li><span>&#x25A0; &#x25A0; &#x25A0; &#x25A0; &#x25A0;</span>React</li>
                        <li><span>&#x25A0; &#x25A0; &#x25A0; &#x25A0; &#x25A0;</span>Redux</li>
                        <li><span>&#x25A0; &#x25A0; &#x25A0;</span>RxJS</li>
                        <li><span>&#x25A0; &#x25A0; &#x25A0; &#x25A0;</span>Storybook</li>
                        <li><span>&#x25A0; &#x25A0; &#x25A0;</span>Express</li>
                        <li><span>&#x25A0; &#x25A0; &#x25A0;</span>Spring</li>
                    </ul>
                </figure>
                <figure>
                    <span>- - -</span>
                    <figcaption><%= lookup("h_infrastructure") %></figcaption>
                    <ul>
                        <li><span>&#x25A0; &#x25A0; &#x25A0;</span>AWS</li>
                        <li><span>&#x25A0; &#x25A0; &#x25A0; &#x25A0;</span>Nginx</li>
                        <li><span>&#x25A0; &#x25A0; &#x25A0; &#x25A0;</span>Docker</li>
                        <li><span>&#x25A0; &#x25A0;</span>Kubernetes</li>
                    </ul>
                </figure>
            </section>
            <section class="mw-resume-methods">
                <h2><span><%= lookup("h_methodology") %></span></h2>
                <ul>
                    <li>Agile / Scrum</li>
                    <li>TDD / BDD</li>
                    <li>CI / CD</li>
                </ul>
            </section>
        </div>
    </div>
    <div class="mw-pagebreak"></div>
    <div class="mw-resume-page pg2">
        <div class="mw-resume-content pg2">
            <div class="mw-resume-exp">
                <h2><span><%= lookup("h_experience") %> <%- lookup("h_continued") %></span></h2>
                <article>
                    <header class="mw-resume-job-title">
                        <p>
                            <span><%= lookup("appl_jobtitle") %></span><br/>
