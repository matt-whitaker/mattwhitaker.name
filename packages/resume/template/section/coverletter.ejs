<article>
    <%- await include("/template/component/subtitle.ejs", { alt: false }) %>
    <div class="pl-large">
    <% for (let i = 0; i < 5; i++) { %>
    <% if (lookup(`cover_body_${i}`, "")) { %>
        <p class="text-sm first-of-type:mt-large mt-xsmall"><%- lookup(`cover_body_${i}`) %></p>
    <% } %>
    <% } %>
        <p class="text-sm mt-large"><%- lookup("cover_signature") %></p>
    </div>
</article>